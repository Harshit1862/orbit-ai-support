{
  "name": "ai-support-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:index": "tsx scripts/build-faq-index.mts",
    "eval:retrieval": "tsx scripts/eval-retrieval.mts",
    "db:setup": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local node_modules/tsx/dist/cli.mjs scripts/db-setup.mts",
    "db:inspect": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local node_modules/tsx/dist/cli.mjs scripts/db-inspect.mts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "next": "16.3.6",
    "openai": "^7.21.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
